{
  "name": "ux-design-shared",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Heuresys UI Design System — 180+ reusable React components, extracted from @heuresys/ui",
  "license": "MIT",
  "author": "Heuresys <info@heuresys.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/heuresys/ux-design-shared.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "install:deps": "cd ui && pnpm install --frozen-lockfile",
    "dev": "cd ui && pnpm run dev",
    "storybook": "cd ui && pnpm run storybook",
    "build-storybook": "cd ui && pnpm run build-storybook",
    "typecheck": "cd ui && pnpm run typecheck",
    "test": "cd ui && pnpm run test",
    "test:watch": "cd ui && pnpm run test:watch",
    "test:coverage": "cd ui && pnpm run test:coverage",
    "clean": "cd ui && pnpm run clean && rm -rf node_modules"
  },
  "workspaces": [
    "ui"
  ],
  "devDependencies": {
    "prettier": "3.8.3"
  }
}
